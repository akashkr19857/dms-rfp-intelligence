# Copy to .env to override defaults (all optional). Everything runs locally; no API keys needed.
RFP_OLLAMA_URL=http://localhost:11434
RFP_LLM_MODEL=qwen2.5:7b
RFP_EMBED_MODEL=nomic-embed-text
RFP_RERANKER_MODEL=BAAI/bge-reranker-base
# bm25 | vector | hybrid
RFP_RETRIEVAL_MODE=hybrid
RFP_USE_RERANKER=true
RFP_TOP_K=5
# RFP text per requirement-extraction call, knowledge-base passages per compliance check
RFP_REQ_BATCH_CHARS=3600
RFP_KB_EVIDENCE_K=4
RFP_CORS_ORIGINS=http://localhost:3200,http://127.0.0.1:3200
# Frontend (frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8200
